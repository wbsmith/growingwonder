<%- include('../layout_head', { title: 'Messages' }) %>
<link rel="stylesheet" href="/css/admin.css">

<div class="admin-layout">
  <%- include('_sidebar', { active: 'messages', tab: tab, unreadInbox: typeof unreadInbox !== 'undefined' ? unreadInbox : 0, failuresCount: typeof failuresCount !== 'undefined' ? failuresCount : 0 }) %>
  <main class="admin-main">
    <h1><%= tab === 'bulk' ? 'Bulk Send' : tab === 'inquiries' ? 'Inquiries' : tab === 'failures' ? 'Delivery Issues' : 'Inbox' %></h1>

    <% if (tab === 'confirmations') { %>
      <!-- INBOX TAB (mirrors registration@ + info@; threaded; live-updating) -->
      <%
        const filterOpts = [
          { key: 'all', label: 'All' },
          { key: 'registration', label: 'Registration' },
          { key: 'info', label: 'Info' },
          { key: 'unread', label: 'Unread' },
          { key: 'confirmations', label: 'Confirmations' },
          { key: 'general', label: 'General' },
          { key: 'archived', label: 'Archived' },
        ];
        const activeFilter = typeof filter !== 'undefined' ? filter : 'all';
        const qVal = typeof q !== 'undefined' ? q : '';
        const qSuffix = qVal ? '&q=' + encodeURIComponent(qVal) : '';
      %>
      <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
        <div style="display:flex; gap:6px; flex-wrap:wrap;">
          <% filterOpts.forEach(f => { %>
            <a href="/admin/messages?tab=confirmations&filter=<%= f.key %><%= qSuffix %>"
               class="btn btn-sm <%= activeFilter === f.key ? 'btn-green' : 'btn-outline' %>"><%= f.label %></a>
          <% }) %>
        </div>
        <div style="display:flex; align-items:center; gap:10px;">
          <input type="search" id="inboxSearch" placeholder="Search mail…" value="<%= qVal %>"
            style="padding:6px 12px; border:1px solid #ccc; border-radius:var(--radius); font-size:0.85rem; min-width:200px;">
          <span id="refreshStatus" style="font-size:0.8rem; color:var(--text-light);"></span>
          <% if (mailEnabled) { %>
            <button type="button" class="btn btn-outline btn-sm" id="refreshInboxBtn" onclick="refreshInbox(true)">&#x21bb; Refresh</button>
          <% } else { %>
            <span style="font-size:0.8rem; color:var(--text-light);" title="Set MAIL_* env vars to enable inbound sync">Inbound not configured</span>
          <% } %>
        </div>
      </div>

      <p id="inboxEmpty" style="color: var(--text-light); <%= threads.length === 0 ? '' : 'display:none;' %>">No messages<%= activeFilter !== 'all' || qVal ? ' for this filter' : '' %>.</p>
      <table class="data-table" id="inboxTable" style="<%= threads.length === 0 ? 'display:none;' : '' %>">
        <thead>
          <tr>
            <th></th>
            <th>From / To</th>
            <th>Subject</th>
            <th>Messages</th>
            <th>Latest</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="inboxBody">
          <% threads.forEach(t => { %><%- renderThreadRow(t) %><% }) %>
        </tbody>
      </table>

      <!-- Shared row renderer: the browser uses the very same function the server
           used above, so live-inserted rows match server-rendered ones exactly. -->
      <script src="/js/inbox-render.js"></script>
      <script>
      (function () {
        <%# escape "<" so a crafted ?q=</script>... value can't break out of this script %>
        var FILTER = <%- JSON.stringify(activeFilter).replace(/</g, '\\u003c') %>;
        var Q = <%- JSON.stringify(qVal).replace(/</g, '\\u003c') %>;
        var MAIL_ENABLED = <%- JSON.stringify(!!mailEnabled) %>;
        var POLL_MS = 15000;
        var tbody = document.getElementById('inboxBody');
        var tableEl = document.getElementById('inboxTable');
        var emptyEl = document.getElementById('inboxEmpty');
        var statusEl = document.getElementById('refreshStatus');
        var searchEl = document.getElementById('inboxSearch');
        var timer = null;

        function feedUrl() {
          return '/admin/messages/feed?filter=' + encodeURIComponent(FILTER) + '&q=' + encodeURIComponent(Q);
        }

        // Keep the sidebar unread pill in sync without a reload.
        function updateUnreadPill(n) {
          var a = document.getElementById('navInbox'); if (!a) return;
          var badge = document.getElementById('navUnread');
          if (n > 0) {
            if (!badge) {
              badge = document.createElement('span');
              badge.id = 'navUnread';
              badge.style.cssText = 'background: var(--green-dark); color:#fff; border-radius:10px; padding:0 6px; font-size:0.7rem; font-weight:700; margin-left:4px;';
              a.appendChild(badge);
            }
            badge.textContent = n;
          } else if (badge) { badge.remove(); }
        }

        // Upsert rows by data-thread-key, in feed order; remove rows that dropped
        // out of the current filter/search. Unchanged rows (same data-sig) are
        // left in place so the CSRF-injected forms survive.
        function applyThreads(threads) {
          if (!tbody) return;
          var existing = {};
          Array.prototype.forEach.call(tbody.querySelectorAll('tr[data-thread-key]'), function (r) {
            existing[r.getAttribute('data-thread-key')] = r;
          });
          var seen = {};
          threads.forEach(function (t) {
            seen[t.key] = true;
            var cur = existing[t.key];
            var tmp = document.createElement('tbody');
            tmp.innerHTML = window.renderThreadRow(t);
            var fresh = tmp.firstElementChild;
            if (cur) {
              if (cur.getAttribute('data-sig') !== fresh.getAttribute('data-sig')) { cur.replaceWith(fresh); cur = fresh; }
            } else { cur = fresh; }
            tbody.appendChild(cur); // move into feed order (no-op if already there)
          });
          Object.keys(existing).forEach(function (k) { if (!seen[k]) existing[k].remove(); });
          var any = threads.length > 0;
          if (tableEl) tableEl.style.display = any ? '' : 'none';
          if (emptyEl) emptyEl.style.display = any ? 'none' : '';
        }

        async function pollFeed() {
          try {
            var res = await fetch(feedUrl(), { headers: { 'Accept': 'application/json' } });
            if (!res.ok) return;
            var data = await res.json();
            applyThreads(data.threads || []);
            updateUnreadPill(data.unreadInbound || 0);
          } catch (e) { /* transient; next tick retries */ }
        }

        // Refresh button: pull new mail over IMAP (if configured), then patch the
        // DOM from the feed — no full-page reload.
        async function refreshInbox(manual) {
          var btn = document.getElementById('refreshInboxBtn');
          if (btn) btn.disabled = true;
          if (statusEl) statusEl.textContent = manual ? 'Checking mail…' : '';
          try {
            if (MAIL_ENABLED) {
              var res = await fetch('/admin/messages/refresh', { method: 'POST' });
              var data = await res.json();
              if (statusEl) statusEl.textContent = manual
                ? (data.ok ? (data.total > 0 ? 'New mail.' : 'No new messages.') : ('Error: ' + (data.error || 'sync failed')))
                : '';
            }
            await pollFeed();
          } catch (e) {
            if (statusEl) statusEl.textContent = manual ? 'Refresh failed.' : '';
          } finally {
            if (btn) btn.disabled = false;
          }
        }
        window.refreshInbox = refreshInbox;

        function startPolling() {
          if (timer) return;
          timer = setInterval(function () { if (!document.hidden) pollFeed(); }, POLL_MS);
        }
        // Catch up as soon as the tab becomes visible again.
        document.addEventListener('visibilitychange', function () { if (!document.hidden) pollFeed(); });

        // Debounced live search → /feed?q=; keeps the URL deep-linkable.
        if (searchEl) {
          var st = null;
          searchEl.addEventListener('input', function () {
            clearTimeout(st);
            st = setTimeout(function () {
              Q = searchEl.value.trim();
              try {
                var u = new URL(window.location.href);
                if (Q) u.searchParams.set('q', Q); else u.searchParams.delete('q');
                history.replaceState(null, '', u.toString());
              } catch (e) { /* older browser; skip URL sync */ }
              pollFeed();
            }, 300);
          });
        }

        // Pull mail once on load (silent) then poll on an interval.
        window.addEventListener('load', function () {
          setTimeout(function () { refreshInbox(false); }, 400);
          startPolling();
        });
      })();
      </script>

    <% } else if (tab === 'failures') { %>
      <!-- DELIVERY ISSUES TAB (read-only; empty until outbound-delivery tracking lands) -->
      <% if (!failures || failures.length === 0) { %>
        <p style="color: var(--text-light);">No delivery issues. Bounces, complaints, and send failures will appear here.</p>
      <% } else { %>
        <table class="data-table">
          <thead>
            <tr><th>Status</th><th>To</th><th>Subject</th><th>Reason</th><th>When</th></tr>
          </thead>
          <tbody>
            <% failures.forEach(f => { %>
              <tr>
                <td><span class="badge badge-failed"><%= f.status %></span></td>
                <td><%= f.toAddr %></td>
                <td><%= f.subject %></td>
                <td style="font-size:0.8rem; color:var(--text-light);"><%= f.failureReason || f.bounceType || '' %></td>
                <td style="font-size:0.8rem;"><%= f.eventAt || f.sentAt || f.createdAt || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

    <% } else if (tab === 'bulk') { %>
      <!-- BULK SEND TAB -->
      <div style="background: var(--white); border-radius: var(--radius); padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 24px;">
        <h3 style="margin-bottom: 16px; color: var(--green-dark); font-size: 1rem;">Select Recipients</h3>
        <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-end;">
          <div class="form-group" style="margin-bottom: 0;">
            <label>Scope</label>
            <select id="scope" onchange="updateScopeUI()">
              <option value="manual">Manual only</option>
              <option value="all">All enrolled parents</option>
              <option value="program">All in a program</option>
              <option value="week">Enrolled in a week</option>
              <option value="day">Enrolled on a day</option>
            </select>
          </div>
          <div class="form-group" style="margin-bottom: 0; display: none;" id="programGroup">
            <label>Program</label>
            <select id="bulkProgramSelect" onchange="updateDateOptions()">
              <option value="">Choose...</option>
              <% programs.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group" style="margin-bottom: 0; display: none;" id="weekGroup">
            <label>Week</label>
            <select id="weekSelect"></select>
          </div>
          <div class="form-group" style="margin-bottom: 0; display: none;" id="dayGroup">
            <label>Date</label>
            <select id="daySelect"></select>
          </div>
          <button type="button" class="btn btn-outline btn-sm" id="loadRecipientsBtn" onclick="fetchRecipients()">Load Recipients</button>
          <span id="loadStatus" style="font-size:0.8rem; color:var(--text-light);"></span>
        </div>
        <!-- Loaded recipients render as editable chips in the send form below. -->
      </div>
      <form method="POST" action="/admin/messages/bulk/send" id="bulkSendForm">
        <input type="hidden" name="recipients" id="recipientHidden">
        <input type="hidden" name="body" id="bulkBodyHidden">
        <input type="hidden" name="body_format" value="html">
        <input type="hidden" name="attachment_keys" id="bulkAttachKeys" value="">

        <!-- Recipients: editable chip list (the send list; source of truth) -->
        <div class="form-group">
          <label>Recipients <span id="recipCount" style="font-weight:normal; color:var(--text-light);">(0)</span>
            <a href="#" id="clearRecipsBtn" onclick="clearRecips(); return false;"
               style="font-weight:normal; font-size:0.8rem; margin-left:8px; display:none;">Clear all</a>
          </label>
          <div id="chipList" style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:8px;"></div>
          <input type="text" id="manualRecipients" placeholder="Type an email and press Enter to add"
            style="padding: 10px 14px; border: 1px solid #ccc; border-radius: var(--radius); width: 100%;">
          <div style="font-size:0.78rem; color:var(--text-light); margin-top:4px;">
            Use “Load Recipients” above to add a group, then edit here — click × to remove any address, or type to add more.
            Each recipient gets a private individual email; no one sees the others.
          </div>
        </div>

        <div class="form-group">
          <label>Subject</label>
          <input type="text" name="subject" required style="padding: 10px 14px; border: 1px solid #ccc; border-radius: var(--radius); width: 100%;">
        </div>

        <!-- Rich text editor -->
        <div class="form-group">
          <label>Message</label>
          <link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet">
          <div id="bulkEditor" style="min-height: 200px; background: var(--white);"></div>
        </div>

        <!-- Attachments -->
        <div style="margin-bottom: 16px; padding: 16px; background: var(--white); border-radius: var(--radius); border: 1px solid #ddd;">
          <label style="font-weight: 700; font-size: 0.9rem; display: block; margin-bottom: 8px;">Attachments</label>
          <div id="bulkAttachList"></div>
          <div style="display: flex; gap: 8px; align-items: center;">
            <input type="file" id="bulkAttachFile" style="font-size: 0.85rem;">
            <button type="button" class="btn btn-outline btn-sm" onclick="addBulkAttachment()">Add</button>
          </div>
          <div id="bulkAttachStatus" style="font-size: 0.85rem; color: var(--text-light); margin-top: 4px;"></div>
        </div>

        <button type="submit" class="btn btn-green" id="sendBtn">
          Send Email
        </button>
      </form>
      <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
      <script src="/js/admin-quill.js"></script>
      <script>
      const programWeeks = <%- JSON.stringify(programWeeks) %>;

      const bulkQuill = createAdminQuill('#bulkEditor', {
        placeholder: 'Type your message...',
      });

      // ---- Editable recipient chips (single source of truth for the send list) ----
      const recips = [];
      const isEmail = s => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s);
      function renderRecips() {
        const list = document.getElementById('chipList');
        list.innerHTML = '';
        recips.forEach(email => {
          const chip = document.createElement('span');
          chip.style.cssText = 'display:inline-flex; align-items:center; gap:6px; background:var(--sand); border:1px solid #ddd; border-radius:14px; padding:3px 6px 3px 10px; font-size:0.8rem;';
          const t = document.createElement('span'); t.textContent = email; chip.appendChild(t);
          const x = document.createElement('button'); x.type = 'button'; x.textContent = '×';
          x.setAttribute('aria-label', 'Remove ' + email);
          x.style.cssText = 'background:none; border:none; cursor:pointer; color:var(--red); font-size:1.05rem; line-height:1; padding:0 2px;';
          x.onclick = () => removeRecip(email);
          chip.appendChild(x);
          list.appendChild(chip);
        });
        document.getElementById('recipCount').textContent = '(' + recips.length + ')';
        document.getElementById('clearRecipsBtn').style.display = recips.length ? '' : 'none';
        document.getElementById('recipientHidden').value = recips.join(',');
        document.getElementById('sendBtn').disabled = recips.length === 0;
      }
      function addRecip(email) {
        const e = String(email || '').trim();
        if (!e || !isEmail(e)) return false;
        if (recips.some(r => r.toLowerCase() === e.toLowerCase())) return false;
        recips.push(e); return true;
      }
      function addRecips(arr) { (arr || []).forEach(addRecip); renderRecips(); }
      function removeRecip(email) {
        const i = recips.findIndex(r => r.toLowerCase() === email.toLowerCase());
        if (i >= 0) { recips.splice(i, 1); renderRecips(); }
      }
      function clearRecips() { recips.length = 0; renderRecips(); }
      // Manual add: Enter or comma commits valid emails; unfinished text stays put.
      (function () {
        const inp = document.getElementById('manualRecipients');
        const flush = () => {
          const parts = inp.value.split(/[,\s]+/).map(s => s.trim()).filter(Boolean);
          let added = false;
          parts.forEach(p => { if (addRecip(p)) added = true; });
          inp.value = parts.filter(p => !isEmail(p)).join(', '); // keep partial/invalid text
          if (added) renderRecips();
        };
        inp.addEventListener('keydown', ev => { if (ev.key === 'Enter' || ev.key === ',') { ev.preventDefault(); flush(); } });
        inp.addEventListener('blur', flush);
      })();
      renderRecips(); // initial state: 0 recipients -> Send disabled

      // Finalize body + recipients on submit.
      document.getElementById('bulkSendForm').addEventListener('submit', function (e) {
        const inp = document.getElementById('manualRecipients');
        inp.value.split(/[,\s]+/).map(s => s.trim()).filter(Boolean).forEach(addRecip);
        inp.value = '';
        renderRecips();
        document.getElementById('bulkBodyHidden').value = bulkQuill.getCleanHtml();
        document.getElementById('recipientHidden').value = recips.join(',');
        if (recips.length === 0) { alert('Add at least one recipient.'); e.preventDefault(); return false; }
      });
      function updateScopeUI() {
        const scope = document.getElementById('scope').value;
        const isManual = scope === 'manual';
        document.getElementById('programGroup').style.display = (scope === 'all' || isManual) ? 'none' : '';
        document.getElementById('weekGroup').style.display = (scope === 'week') ? '' : 'none';
        document.getElementById('dayGroup').style.display = (scope === 'day') ? '' : 'none';
        document.getElementById('loadRecipientsBtn').style.display = isManual ? 'none' : '';
        // Recipients persist across scope changes (the chips are the source of truth);
        // Send button state is driven by renderRecips().
      }
      function updateDateOptions() {
        const pid = document.getElementById('bulkProgramSelect').value;
        if (!pid || !programWeeks[pid]) return;
        const data = programWeeks[pid];
        const weekSel = document.getElementById('weekSelect');
        weekSel.innerHTML = '';
        data.weeks.forEach(w => { const o = document.createElement('option'); o.value = w.monday; o.textContent = w.monday + ' to ' + w.friday; weekSel.appendChild(o); });
        const daySel = document.getElementById('daySelect');
        daySel.innerHTML = '';
        data.dates.forEach(d => { const o = document.createElement('option'); o.value = d; const dt = new Date(d+'T00:00:00'); o.textContent = dt.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'})+' ('+d+')'; daySel.appendChild(o); });
      }
      async function fetchRecipients() {
        const scope = document.getElementById('scope').value;
        const programId = document.getElementById('bulkProgramSelect').value;
        const body = { scope };
        if (scope !== 'all') body.programId = programId;
        if (scope === 'week') body.weekStart = document.getElementById('weekSelect').value;
        if (scope === 'day') body.date = document.getElementById('daySelect').value;
        const status = document.getElementById('loadStatus');
        const btn = document.getElementById('loadRecipientsBtn');
        btn.disabled = true; status.textContent = 'Loading…';
        try {
          const res = await fetch('/admin/messages/bulk/recipients', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
          const data = await res.json();
          const emails = data.emails || [];
          const before = recips.length;
          addRecips(emails); // merges into the editable chip list (dedupes)
          const added = recips.length - before;
          status.textContent = `Loaded ${emails.length} — added ${added} new` + (emails.length - added > 0 ? `, ${emails.length - added} already in list.` : '.');
        } catch (e) {
          status.textContent = 'Load failed.';
        } finally {
          btn.disabled = false;
        }
      }

      // Bulk attachments
      const bulkAttachments = []; // [{filename, key, contentType}]
      async function addBulkAttachment() {
        const file = document.getElementById('bulkAttachFile').files[0];
        const status = document.getElementById('bulkAttachStatus');
        if (!file) { status.textContent = 'Select a file first.'; return; }
        status.textContent = 'Uploading...';
        try {
          const res = await fetch('/admin/messages/bulk/upload-url', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, contentType: file.type }),
          });
          const presigned = await res.json();
          await fetch(presigned.uploadUrl, { method: 'PUT', headers: { 'Content-Type': file.type }, body: file });
          bulkAttachments.push({ filename: file.name, key: presigned.key, contentType: file.type });
          renderBulkAttachments();
          document.getElementById('bulkAttachFile').value = '';
          status.textContent = '';
        } catch (err) {
          status.textContent = 'Upload failed: ' + err.message;
        }
      }
      function renderBulkAttachments() {
        const list = document.getElementById('bulkAttachList');
        list.innerHTML = bulkAttachments.map((a, i) =>
          '<div style="display:flex;align-items:center;gap:8px;padding:4px 0;font-size:0.85rem;">' +
          '<span>' + a.filename + '</span>' +
          '<a href="#" onclick="removeBulkAttachment(' + i + '); return false;" style="color:var(--red);font-size:0.8rem;">Remove</a>' +
          '</div>'
        ).join('');
        document.getElementById('bulkAttachKeys').value = JSON.stringify(bulkAttachments);
      }
      function removeBulkAttachment(idx) {
        bulkAttachments.splice(idx, 1);
        renderBulkAttachments();
      }
      </script>

    <% } else if (tab === 'inquiries') { %>
      <!-- INQUIRIES TAB -->
      <% if (inquiries.length === 0) { %>
        <p style="color: var(--text-light);">No inquiries yet.</p>
      <% } else { %>
        <table class="data-table">
          <thead>
            <tr>
              <th>Status</th>
              <th>Subject</th>
              <th>From</th>
              <th>Contact</th>
              <th>Message</th>
              <th>Received</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% inquiries.forEach(i => { %>
              <tr>
                <td><span class="badge badge-<%= i.status === 'new' ? 'draft' : 'sent' %>"><%= i.status %></span></td>
                <td><%= i.subject %></td>
                <td><%= i.name || '—' %></td>
                <td style="font-size: 0.8rem;">
                  <% if (i.email) { %><div><%= i.email %></div><% } %>
                  <% if (i.phone) { %><div><%= i.phone %></div><% } %>
                </td>
                <td style="font-size: 0.85rem; max-width: 250px;"><%= i.message %></td>
                <td style="font-size: 0.8rem;"><%= i.createdAt %></td>
                <td>
                  <a href="/admin/messages/inquiries/<%= i.id %>" class="btn btn-outline btn-sm"><%= i.status === 'new' ? 'Reply' : 'View' %></a>
                  <form method="POST" action="/admin/messages/delete" style="display:inline; margin-left: 4px;">
                    <input type="hidden" name="type" value="inquiry">
                    <input type="hidden" name="item_id" value="<%= i.id %>">
                    <button type="submit" style="background:none;border:none;color:var(--red);cursor:pointer;font-size:0.9rem;padding:2px 4px;" title="Delete"
                      onclick="return confirm('Delete this inquiry?')">&times;</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    <% } %>
  </main>
</div>

<%- include('../layout_foot') %>
